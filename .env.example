# Copia este archivo como .env únicamente si no usarás el inicializador seguro.
# Nunca confirmes .env en Git.
POSTGRES_DB=prestamoplus
POSTGRES_USER=prestamoplus
POSTGRES_PASSWORD=
# Para el PostgreSQL del mismo Compose: postgres / 5432.
# En una base administrada de Dokploy usa el host y puerto que te proporcione.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Alternativa para Dokploy: usa la cadena completa de la base administrada.
# ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=...;Username=...;Password=...
# DATABASE_CONNECTION_STRING=Host=...;Port=5432;Database=...;Username=...;Password=...

# Secretos de la API: usa .NET User Secrets o variables protegidas.
# ClientAuthentication__OtpPepper=
# Resend API (required to deliver registration, proposal and payment emails)
# RESEND_API_KEY=
# Usa un dominio verificado en Resend; no uses onboarding@resend.dev en producción.
# RESEND_FROM_EMAIL=notificaciones@correo.tudominio.com
# RESEND_FROM_NAME=Bonexa
# RESEND_REPLY_TO_EMAIL=soporte@tudominio.com
# RESEND_CLIENT_PORTAL_URL=https://app.tudominio.com/portal/login

# Variables opcionales del frontend.
VITE_API_URL=http://localhost:5001/api

# Cloudflare Tunnel (Dokploy): pega aquí el token del túnel.
# El túnel debe apuntar al servicio Docker http://frontend:3005.
# CLOUDFLARED_TUNNEL_TOKEN=
# ASPNETCORE_ENVIRONMENT=Production
