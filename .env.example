# Copia este archivo como .env únicamente si no usarás el inicializador seguro.
# Nunca confirmes .env en Git.
POSTGRES_DB=prestamoplus
POSTGRES_USER=prestamoplus
POSTGRES_PASSWORD=

# Secretos de la API: usa .NET User Secrets o variables protegidas.
# ClientAuthentication__OtpPepper=
# Resend API (required to deliver registration, proposal and payment emails)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=PrestamoPlus
# RESEND_CLIENT_PORTAL_URL=http://localhost:8088/portal/login

# Variables opcionales del frontend.
VITE_API_URL=http://localhost:5001/api

# Cloudflare Tunnel (Dokploy): pega aquí el token del túnel.
# El túnel debe apuntar al servicio Docker http://frontend:3005.
# CLOUDFLARED_TUNNEL_TOKEN=
# ASPNETCORE_ENVIRONMENT=Production
